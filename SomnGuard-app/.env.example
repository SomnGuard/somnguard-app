# SomnGuard App — Variables de entorno
# Copia este archivo como .env y ajusta valores. NO commitear .env
# EXPO_PUBLIC_ es obligatorio para que Expo exponga la variable al JS bundle

# URL base del backend (sin trailing slash)
# Local: http://localhost:8080
# Móvil físico con Expo Go: usa tu IP LAN, ej: http://192.168.1.50:8080
EXPO_PUBLIC_API_URL=http://localhost:8080
